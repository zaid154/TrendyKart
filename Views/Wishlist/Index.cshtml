@model IEnumerable<TrendyKart.Models.Wishlist>
@{
    ViewData["Title"] = "My Wishlist";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-heart text-danger me-2"></i> My Wishlist</h2>
        <span class="badge bg-primary fs-6">@Model.Count() Items Saved</span>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 shadow-sm rounded bg-light">
            <i class="far fa-heart fa-4x text-muted mb-3"></i>
            <h4>Your wishlist is empty!</h4>
            <p class="text-muted">Explore our catalog and save items you love.</p>
            <a href="@Url.Action("Index", "Product")" class="btn btn-primary btn-lg mt-2">
                <i class="fas fa-shopping-bag me-1"></i> Continue Shopping
            </a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var item in Model)
            {
                var prod = item.Product;
                if (prod == null) continue;
                var displayPrice = item.Variant != null ? item.Variant.Price : prod.Price;
                var oldPrice = item.Variant != null ? item.Variant.OldPrice : prod.OldPrice;
                var image = !string.IsNullOrEmpty(prod.ImageUrl) ? prod.ImageUrl : "/images/no-image.png";

                <div class="col">
                    <div class="card h-100 shadow-sm border-0 position-relative hover-shadow">
                        <img src="@image" class="card-img-top p-3" alt="@prod.Name" style="height: 220px; object-fit: contain;">
                        <div class="card-body d-flex flex-column">
                            <small class="text-muted text-uppercase fw-semibold mb-1">@prod.Brand</small>
                            <h6 class="card-title fw-bold text-truncate" title="@prod.Name">@prod.Name</h6>
                            
                            @if (item.Variant != null)
                            {
                                <span class="badge bg-secondary mb-2 align-self-start">Variant: @item.Variant.ColorName</span>
                            }

                            <div class="mt-auto pt-2">
                                <div class="d-flex align-items-center gap-2 mb-3">
                                    <span class="h5 fw-bold text-success mb-0">₹@displayPrice.ToString("N2")</span>
                                    @if (oldPrice.HasValue && oldPrice > displayPrice)
                                    {
                                        <span class="text-muted text-decoration-line-through small">₹@oldPrice.Value.ToString("N2")</span>
                                    }
                                </div>

                                <div class="d-flex gap-2">
                                    <a href="@Url.Action("Details", "Product", new { id = prod.ProductID })" class="btn btn-outline-primary btn-sm flex-grow-1">
                                        <i class="fas fa-eye me-1"></i> View
                                    </a>
                                    <form asp-action="Remove" asp-route-id="@item.WishlistID" method="post">
                                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Remove from wishlist">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
