@model IEnumerable<TrendyKart.Models.CustomerAddress>
@{
    ViewData["Title"] = "My Saved Addresses";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-map-marker-alt text-primary me-2"></i> Saved Addresses</h2>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addAddressModal">
            <i class="fas fa-plus me-1"></i> Add New Address
        </button>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 shadow-sm rounded bg-light">
            <i class="fas fa-home fa-4x text-muted mb-3"></i>
            <h4>No saved addresses found</h4>
            <p class="text-muted">Add your delivery addresses for quick checkout.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 g-4">
            @foreach (var addr in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 @(addr.IsDefault ? "border-start border-4 border-primary" : "")">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-secondary">@addr.AddressType</span>
                                @if (addr.IsDefault)
                                {
                                    <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i> Default</span>
                                }
                            </div>
                            <h5 class="card-title fw-bold">@addr.FullName</h5>
                            <p class="card-text text-muted mb-1"><i class="fas fa-phone me-1"></i> @addr.Phone</p>
                            <p class="card-text mb-2">
                                @addr.AddressLine1 @(!string.IsNullOrEmpty(addr.AddressLine2) ? ", " + addr.AddressLine2 : "")<br />
                                @addr.City, @addr.State - <strong>@addr.Pincode</strong>
                            </p>
                            <div class="d-flex gap-2 mt-3">
                                @if (!addr.IsDefault)
                                {
                                    <button onclick="setDefaultAddress(@addr.AddressID)" class="btn btn-outline-primary btn-sm">Set as Default</button>
                                }
                                <button onclick="deleteAddress(@addr.AddressID)" class="btn btn-outline-danger btn-sm"><i class="fas fa-trash-alt me-1"></i> Delete</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Add Address Modal -->
<div class="modal fade" id="addAddressModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-map-marker-alt me-2"></i> Add New Address</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="addAddressForm">
                    <div class="mb-3">
                        <label class="form-label">Full Name *</label>
                        <input type="text" id="addrFullName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Phone Number *</label>
                        <input type="tel" id="addrPhone" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Street / Address Line 1 *</label>
                        <input type="text" id="addrLine1" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Address Line 2 (Optional)</label>
                        <input type="text" id="addrLine2" class="form-control" />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">City *</label>
                            <input type="text" id="addrCity" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">State *</label>
                            <input type="text" id="addrState" class="form-control" required />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Pin Code *</label>
                            <input type="text" id="addrPincode" class="form-control" required maxlength="6" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Address Type</label>
                            <select id="addrType" class="form-select">
                                <option value="Home">Home</option>
                                <option value="Office">Office</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="addrIsDefault">
                        <label class="form-check-input-label" for="addrIsDefault">Set as Default Address</label>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Save Address</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $('#addAddressForm').on('submit', function (e) {
            e.preventDefault();
            const data = {
                fullName: $('#addrFullName').val(),
                phone: $('#addrPhone').val(),
                addressLine1: $('#addrLine1').val(),
                addressLine2: $('#addrLine2').val(),
                city: $('#addrCity').val(),
                state: $('#addrState').val(),
                pincode: $('#addrPincode').val(),
                addressType: $('#addrType').val(),
                isDefault: $('#addrIsDefault').is(':checked')
            };

            $.post('/Account/AddAddress', data, function (res) {
                if (res.success) {
                    location.reload();
                } else {
                    alert(res.message);
                }
            });
        });

        function setDefaultAddress(id) {
            $.post('/Account/SetDefaultAddress', { id: id }, function (res) {
                if (res.success) location.reload();
            });
        }

        function deleteAddress(id) {
            if (confirm('Are you sure you want to delete this address?')) {
                $.post('/Account/DeleteAddress', { id: id }, function (res) {
                    if (res.success) location.reload();
                });
            }
        }
    </script>
}
