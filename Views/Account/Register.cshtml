@{
    ViewData["Title"] = "Create Account";
    Layout = "_StoreLayout";
}

<div style="min-height: calc(100vh - 73px); background: #ffffff; display: flex; align-items: center; justify-content: center; padding: 10px 16px; box-sizing: border-box; overflow: hidden;">
    <div style="width: 100%; max-width: 860px; height: 490px; background: linear-gradient(180deg, #f8f7f2 0%, #fcf3cd 100%); border-radius: 28px; box-shadow: 0 16px 40px rgba(0,0,0,0.08); display: flex; overflow: hidden; position: relative;">
        
        <!-- Left Auth Form Panel -->
        <div style="flex: 1; padding: 24px 36px; display: flex; flex-direction: column; justify-content: space-between; position: relative;">
            
            <!-- Top Pill Logo -->
            <div>
                <a href="/" style="display: inline-block; padding: 5px 18px; border: 1px solid #94a3b8; border-radius: 20px; font-size: 12px; font-weight: 600; color: #1e293b; text-decoration: none;">
                    TrendyKart
                </a>
            </div>

            <!-- Main Form Block -->
            <div style="max-width: 310px; width: 100%; margin: 0 auto;">
                <div style="text-align: center; margin-bottom: 12px;">
                    <h2 style="font-size: 20px; font-weight: 700; color: #0f172a; margin-bottom: 2px; letter-spacing: -0.3px;">Create an account</h2>
                    <p style="font-size: 12px; color: #64748b; margin: 0;">Sign up to get exclusive member deals</p>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div style="background: #fef2f2; color: #991b1b; font-size: 11px; padding: 6px 12px; border-radius: 14px; margin-bottom: 10px; border: 1px solid #fecaca;">
                        <i class="fas fa-circle-exclamation me-1"></i>@ViewBag.Error
                    </div>
                }

                <form method="post" asp-action="Register">
                    <div style="margin-bottom: 8px;">
                        <label style="display: block; font-size: 11px; font-weight: 600; color: #475569; margin-bottom: 2px; margin-left: 10px;">Full name</label>
                        <input type="text" name="FullName" placeholder="Amélie Laurent" required style="width: 100%; height: 36px; padding: 0 16px; border-radius: 20px; border: 1px solid rgba(0,0,0,0.08); background: rgba(255,255,255,0.9); font-size: 12px; color: #0f172a; outline: none; transition: all 0.15s;" onfocus="this.style.background='#ffffff'; this.style.borderColor='#eab308';" onblur="this.style.background='rgba(255,255,255,0.9)'; this.style.borderColor='rgba(0,0,0,0.08)';" />
                    </div>

                    <div style="margin-bottom: 8px;">
                        <label style="display: block; font-size: 11px; font-weight: 600; color: #475569; margin-bottom: 2px; margin-left: 10px;">Email</label>
                        <input type="email" name="Email" placeholder="amelielaurent7622@gmail.com" required style="width: 100%; height: 36px; padding: 0 16px; border-radius: 20px; border: 1px solid rgba(0,0,0,0.08); background: rgba(255,255,255,0.9); font-size: 12px; color: #0f172a; outline: none; transition: all 0.15s;" onfocus="this.style.background='#ffffff'; this.style.borderColor='#eab308';" onblur="this.style.background='rgba(255,255,255,0.9)'; this.style.borderColor='rgba(0,0,0,0.08)';" />
                    </div>

                    <div style="margin-bottom: 8px;">
                        <label style="display: block; font-size: 11px; font-weight: 600; color: #475569; margin-bottom: 2px; margin-left: 10px;">Phone number</label>
                        <input type="tel" name="Phone" placeholder="+91 9876543210" required style="width: 100%; height: 36px; padding: 0 16px; border-radius: 20px; border: 1px solid rgba(0,0,0,0.08); background: rgba(255,255,255,0.9); font-size: 12px; color: #0f172a; outline: none; transition: all 0.15s;" onfocus="this.style.background='#ffffff'; this.style.borderColor='#eab308';" onblur="this.style.background='rgba(255,255,255,0.9)'; this.style.borderColor='rgba(0,0,0,0.08)';" />
                    </div>

                    <div style="margin-bottom: 12px;">
                        <label style="display: block; font-size: 11px; font-weight: 600; color: #475569; margin-bottom: 2px; margin-left: 10px;">Password</label>
                        <div style="position: relative;">
                            <input type="password" id="regPassword" name="Password" placeholder="••••••••••••••••" required style="width: 100%; height: 36px; padding: 0 38px 0 16px; border-radius: 20px; border: 1px solid rgba(0,0,0,0.08); background: rgba(255,255,255,0.9); font-size: 12px; color: #0f172a; outline: none; transition: all 0.15s;" onfocus="this.style.background='#ffffff'; this.style.borderColor='#eab308';" onblur="this.style.background='rgba(255,255,255,0.9)'; this.style.borderColor='rgba(0,0,0,0.08)';" />
                            <button type="button" onclick="togglePasswordVisibility('regPassword', this)" style="position: absolute; right: 14px; top: 50%; transform: translateY(-50%); background: none; border: none; color: #94a3b8; cursor: pointer; padding: 0;">
                                <i class="fas fa-eye" style="font-size: 12px;"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Yellow Submit Button -->
                    <button type="submit" style="width: 100%; height: 38px; border-radius: 20px; font-size: 13px; font-weight: 700; background: #facc15; color: #0f172a; border: none; cursor: pointer; margin-bottom: 10px; box-shadow: 0 3px 10px rgba(250,204,21,0.35); transition: background 0.15s;" onmouseover="this.style.background='#eab308';" onmouseout="this.style.background='#facc15';">
                        Submit
                    </button>
                </form>

                <!-- Social Buttons (Apple & Google) -->
                <div style="display: flex; gap: 10px; margin-bottom: 8px;">
                    <a href="#" style="flex: 1; height: 32px; border-radius: 20px; border: 1px solid #cbd5e1; background: rgba(255,255,255,0.7); color: #1e293b; text-decoration: none; display: flex; align-items: center; justify-content: center; gap: 6px; font-size: 11px; font-weight: 500;">
                        <i class="fab fa-apple" style="font-size: 13px;"></i> Apple
                    </a>
                    <a asp-controller="Account" asp-action="GoogleLogin" style="flex: 1; height: 32px; border-radius: 20px; border: 1px solid #cbd5e1; background: rgba(255,255,255,0.7); color: #1e293b; text-decoration: none; display: flex; align-items: center; justify-content: center; gap: 6px; font-size: 11px; font-weight: 500;">
                        <svg width="13" height="13" viewBox="0 0 24 24">
                            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                        </svg> Google
                    </a>
                </div>
            </div>

            <!-- Footer Links -->
            <div style="display: flex; justify-content: space-between; align-items: center; font-size: 11px; color: #64748b;">
                <div>
                    Have any account? 
                    <a asp-controller="Account" asp-action="Login" style="color: #0f172a; font-weight: 700; text-decoration: underline;">Sign in</a>
                </div>
                <a href="#" style="color: #64748b; text-decoration: underline;">Terms & Conditions</a>
            </div>
        </div>

        <!-- Right Image & Real-Time Glass Calendar Panel -->
        <div style="flex: 1; margin: 10px; border-radius: 22px; overflow: hidden; position: relative; display: flex; align-items: flex-end;">
            <img src="/images/auth_banner.png" alt="TrendyKart Showcase" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; filter: brightness(0.95);" />
            
            <!-- Top Right Close Button -->
            <a href="/" style="position: absolute; top: 14px; right: 14px; width: 32px; height: 32px; border-radius: 50%; background: rgba(255,255,255,0.85); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; color: #0f172a; text-decoration: none; box-shadow: 0 4px 10px rgba(0,0,0,0.1); z-index: 10;">
                <i class="fas fa-xmark" style="font-size: 14px;"></i>
            </a>

            <!-- Top Notification Pill -->
            <div style="position: absolute; top: 16px; left: 16px; background: #facc15; padding: 8px 14px; border-radius: 10px; font-size: 11px; font-weight: 700; color: #0f172a; box-shadow: 0 6px 16px rgba(0,0,0,0.15); z-index: 5;">
                <div style="display: flex; align-items: center; gap: 6px;">
                    <span style="width: 6px; height: 6px; border-radius: 50%; background: #0f172a;"></span>
                    <span>Member Exclusive Pricing</span>
                </div>
                <div style="font-size: 10px; opacity: 0.8; font-weight: 400; margin-top: 1px;">Join TrendyKart Today</div>
            </div>

            <!-- Glassmorphic Real-Time Calendar Widget (Bottom Overlay) -->
            <div style="position: relative; z-index: 5; margin: 14px; width: 100%;">
                <div style="background: rgba(255, 255, 255, 0.4); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(255,255,255,0.5); border-radius: 16px; padding: 12px 14px; color: #ffffff; box-shadow: 0 10px 25px rgba(0,0,0,0.15);">
                    
                    <!-- Month & Year Header -->
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #ffffff;">
                        <span id="regCalendarMonthYear">JULY 2026</span>
                        <span style="font-size: 10px; background: rgba(0,0,0,0.25); padding: 2px 8px; border-radius: 10px;"><i class="far fa-clock me-1"></i>LIVE</span>
                    </div>

                    <!-- Days of Week Header -->
                    <div style="display: grid; grid-template-columns: repeat(7, 1fr); text-align: center; font-size: 10px; font-weight: 600; color: rgba(255,255,255,0.9); margin-bottom: 6px;">
                        <span>SUN</span><span>MON</span><span>TUE</span><span>WED</span><span>THU</span><span>FRI</span><span>SAT</span>
                    </div>

                    <!-- Real Dynamic Dates Row -->
                    <div id="regCalendarDatesRow" style="display: grid; grid-template-columns: repeat(7, 1fr); text-align: center; font-size: 13px; font-weight: 700; align-items: center;">
                        <!-- Injected dynamically via JS -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function togglePasswordVisibility(inputId, btn) {
        const input = document.getElementById(inputId);
        const icon = btn.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('fa-eye');
            icon.classList.add('fa-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.remove('fa-eye-slash');
            icon.classList.add('fa-eye');
        }
    }

    // Dynamic Real-Time Calendar Generator
    document.addEventListener('DOMContentLoaded', function () {
        const now = new Date();
        const monthNames = ["JANUARY", "FEBRUARY", "MARCH", "APRIL", "MAY", "JUNE", "JULY", "AUGUST", "SEPTEMBER", "OCTOBER", "NOVEMBER", "DECEMBER"];
        
        const monthYearElem = document.getElementById('regCalendarMonthYear');
        if (monthYearElem) {
            monthYearElem.innerText = monthNames[now.getMonth()] + " " + now.getFullYear();
        }

        const datesRow = document.getElementById('regCalendarDatesRow');
        if (datesRow) {
            const today = now.getDate();
            const currentDayOfWeek = now.getDay(); // 0 = Sun, 1 = Mon, ...
            
            // Calculate Sunday of current week
            const sundayDate = new Date(now);
            sundayDate.setDate(today - currentDayOfWeek);

            let html = '';
            for (let i = 0; i < 7; i++) {
                const dateObj = new Date(sundayDate);
                dateObj.setDate(sundayDate.getDate() + i);
                const dayNum = dateObj.getDate();
                const isToday = dateObj.toDateString() === now.toDateString();

                if (isToday) {
                    html += `<div><span style="background: #ffffff; color: #0f172a; width: 26px; height: 26px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; margin: 0 auto; box-shadow: 0 2px 8px rgba(0,0,0,0.2); font-weight: 800;">${dayNum}</span></div>`;
                } else {
                    html += `<div style="color: #ffffff; opacity: 0.85; line-height: 26px;">${dayNum}</div>`;
                }
            }
            datesRow.innerHTML = html;
        }
    });
</script>