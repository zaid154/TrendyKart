<!DOCTYPE html>
<html lang="en">
<head>

    <!-- Basic Meta Settings -->
    <link rel="icon" type="image/png" href="~/Favicon.png" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - TrendyKart</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Local CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- icon -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
        <div class="container">
            <!-- Logo -->
            <a class="navbar-brand fw-bold fs-4"
               asp-controller="Home"
               asp-action="Index">
                TrendyKart
            </a>
            <!-- Mobile Toggle -->
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>
            <!-- Navbar Content -->
            <div class="collapse navbar-collapse" id="mainNavbar">
                <!-- Left Links -->
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">
                            Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Product"
                           asp-action="Index">
                            Shop
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="About">
                            About
                        </a>
                    </li>
                </ul>
                <!-- Right Side -->
                <div class="d-flex align-items-center gap-3">
                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Cart"
                           asp-action="Index"
                           class="nav-link">
                            <i class="fas fa-shopping-cart"></i>
                        </a>
                        <a asp-controller="Order"
                           asp-action="OrderHistory"
                           class="nav-link">
                            My Orders
                        </a>
                        <span class="fw-semibold">
                            @User.Identity.Name
                        </span>
                        <a asp-controller="Account"
                           asp-action="Logout"
                           class="btn btn-sm btn-danger">
                            Logout
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account"
                           asp-action="Login"
                           class="btn btn-outline-dark btn-sm">
                            Login
                        </a>
                        <a asp-controller="Account"
                           asp-action="Register"
                           class="btn btn-primary btn-sm">
                            Register
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>
    <!-- Main Content -->
    <main class="container flex-fill my-4">
        @RenderBody()
    </main>
    <!-- Footer -->
    <footer class="mt-auto py-3 border-top bg-light">
        <div class="container text-center">
            <p class="mb-0">
                © TrendyKart | All rights reserved 
            </p>
        </div>
    </footer>
    <!-- Bootstrap JS -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>