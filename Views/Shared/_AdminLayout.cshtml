<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="icon" type="image/png" href="~/Favicon.png" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] | TrendyKart Admin Console</title>

    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Google Fonts: Plus Jakarta Sans for exact mockup feel -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- FontAwesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        :root {
            --bg-body: #f4f6f9;
            --bg-sidebar: #0b1120;
            --border-sidebar: #1e293b;
            --text-sidebar: #94a3b8;
            --text-sidebar-active: #ffffff;
            --brand-blue: #3b82f6;
            --brand-purple: #4f46e5;
            --border-light: #e2e8f0;
        }

        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            max-width: 100vw;
            overflow-x: hidden;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: var(--bg-body);
            color: #0f172a;
            min-height: 100vh;
            display: flex;
            -webkit-font-smoothing: antialiased;
        }

        /* SIDEBAR (Dark Navy Theme matching mockup) */
        .sidebar {
            width: 250px;
            background: var(--bg-sidebar);
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            display: flex;
            flex-direction: column;
            z-index: 1000;
            border-right: 1px solid #1e293b;
        }

        .sidebar-brand {
            padding: 24px 24px 20px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .sidebar-brand a {
            font-size: 20px;
            font-weight: 800;
            color: #ffffff;
            text-decoration: none;
            letter-spacing: -0.5px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .sidebar-brand .version-badge {
            font-size: 11px;
            background: #312e81;
            color: #818cf8;
            padding: 2px 10px;
            border-radius: 12px;
            font-weight: 700;
        }

        .sidebar-nav {
            padding: 10px 14px;
            flex: 1;
            overflow-y: auto;
        }

        .sidebar-nav::-webkit-scrollbar {
            width: 4px;
        }
        .sidebar-nav::-webkit-scrollbar-thumb {
            background: #1e293b;
            border-radius: 4px;
        }

        .nav-section-title {
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: #475569;
            padding: 18px 12px 6px 12px;
        }

        .nav-link-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 14px;
            color: #94a3b8;
            font-size: 13.5px;
            font-weight: 600;
            text-decoration: none;
            border-radius: 10px;
            margin-bottom: 3px;
            transition: all 0.15s ease;
        }

        .nav-link-item i {
            font-size: 15px;
            width: 20px;
            text-align: center;
            opacity: 0.85;
        }

        .nav-link-item:hover {
            color: #ffffff;
            background: #1e293b;
        }

        .nav-link-item.active {
            color: #ffffff;
            background: linear-gradient(135deg, #2563eb 0%, #4f46e5 100%);
            font-weight: 700;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.35);
        }

        /* PRO TIP SIDEBAR CARD */
        .sidebar-protip-card {
            background: linear-gradient(135deg, #1e1b4b 0%, #0f172a 100%);
            border: 1px solid #312e81;
            border-radius: 14px;
            padding: 14px;
            margin: 12px 14px;
            position: relative;
            overflow: hidden;
        }

        .sidebar-protip-card .protip-title {
            font-size: 12px;
            font-weight: 800;
            color: #fbbf24;
            display: flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 4px;
        }

        .sidebar-protip-card .protip-text {
            font-size: 11px;
            color: #cbd5e1;
            line-height: 1.4;
            max-width: 140px;
        }

        /* BOTTOM USER FOOTER */
        .sidebar-user-footer {
            padding: 16px;
            border-top: 1px solid #1e293b;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .user-avatar-circle {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: #2563eb;
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 14px;
        }

        /* MAIN CONTENT AREA */
        .main-content {
            margin-left: 250px;
            flex: 1;
            min-width: 0;
            width: calc(100% - 250px);
            max-width: calc(100vw - 250px);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            box-sizing: border-box;
        }

        .top-bar {
            background: #ffffff;
            border-bottom: 1px solid var(--border-light);
            padding: 18px 32px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 99;
            width: 100%;
            box-sizing: border-box;
        }

        .page-header-title {
            font-size: 22px;
            font-weight: 800;
            color: #0f172a;
            margin: 0;
            letter-spacing: -0.4px;
        }

        .page-header-subtitle {
            font-size: 13px;
            color: #64748b;
            margin-top: 2px;
        }

        .header-icon-btn {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #475569;
            text-decoration: none;
            position: relative;
            transition: all 0.2s ease;
        }

        .header-icon-btn:hover {
            background: #f1f5f9;
            color: #0f172a;
        }

        .header-icon-btn .badge-dot {
            position: absolute;
            top: 6px;
            right: 6px;
            background: #2563eb;
            color: #ffffff;
            font-size: 9px;
            font-weight: 800;
            width: 15px;
            height: 15px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .page-body {
            padding: 20px 24px;
            flex: 1;
            width: 100%;
            box-sizing: border-box;
        }
    </style>
</head>

<body>

    <!-- SIDEBAR -->
    <aside class="sidebar">
        <div class="sidebar-brand">
            <a href="/Admin/Dashboard">
                <i class="fas fa-bolt" style="font-size: 18px; color: #facc15;"></i> TrendyKart
            </a>
            <span class="version-badge">v2.5</span>
        </div>

        <div class="sidebar-nav">
            <div class="nav-section-title">Overview</div>
            <a href="/Admin/Dashboard" class="nav-link-item @(ViewData["Title"]?.ToString() == "Admin Dashboard" ? "active" : "")">
                <i class="fas fa-house"></i> Dashboard
            </a>

            <div class="nav-section-title">Catalog & Sales</div>
            <a href="/Admin/Products" class="nav-link-item @(ViewData["Title"]?.ToString() == "Product Catalog" || ViewData["Title"]?.ToString() == "Products" || ViewData["Title"]?.ToString() == "Manage Products" ? "active" : "")">
                <i class="fas fa-bag-shopping"></i> Products
            </a>
            <a href="/Admin/AddProduct" class="nav-link-item @(ViewData["Title"]?.ToString() == "Add Product" ? "active" : "")">
                <i class="fas fa-plus-circle"></i> Add Product
            </a>
            <a href="/Admin/Categories" class="nav-link-item @(ViewData["Title"]?.ToString() == "Categories" || ViewData["Title"]?.ToString() == "Manage Categories" ? "active" : "")">
                <i class="fas fa-layer-group"></i> Categories
            </a>
            <a href="/Admin/Orders" class="nav-link-item @(ViewData["Title"]?.ToString() == "Orders" || ViewData["Title"]?.ToString() == "Orders Management" ? "active" : "")">
                <i class="fas fa-cart-shopping"></i> Orders
            </a>
            <a href="/Admin/Payments" class="nav-link-item @(ViewData["Title"]?.ToString() == "Payments" ? "active" : "")">
                <i class="fas fa-credit-card"></i> Payments
            </a>
            <a href="/Admin/Coupons" class="nav-link-item @(ViewData["Title"]?.ToString() == "Coupons" || ViewData["Title"]?.ToString() == "Manage Coupons" ? "active" : "")">
                <i class="fas fa-ticket"></i> Coupons
            </a>

            <div class="nav-section-title">Customers</div>
            <a href="/Admin/Customers" class="nav-link-item @(ViewData["Title"]?.ToString() == "Customers" || ViewData["Title"]?.ToString() == "Manage Users" ? "active" : "")">
                <i class="fas fa-users"></i> Customers
            </a>
            <a href="/Admin/Reviews" class="nav-link-item @(ViewData["Title"]?.ToString() == "Product Reviews" || ViewData["Title"]?.ToString() == "Review Moderation" ? "active" : "")">
                <i class="fas fa-star"></i> Reviews
            </a>

            <div class="nav-section-title">Moderation & Security</div>
            <a href="/Admin/Reviews" class="nav-link-item @(ViewData["Title"]?.ToString() == "Review Moderation" ? "active" : "")">
                <i class="fas fa-shield-halved"></i> Reviews Moderation
            </a>
            <a href="/Admin/AuditLogs" class="nav-link-item @(ViewData["Title"]?.ToString() == "Audit Logs" ? "active" : "")">
                <i class="fas fa-receipt"></i> Audit Logs
            </a>
        </div>

        <!-- PRO TIP CONTAINER -->
        <div class="sidebar-protip-card">
            <div class="protip-title">
                <i class="fas fa-lightbulb"></i> Pro Tip
            </div>
            <div class="protip-text">
                Use filters and search to quickly find products.
            </div>
        </div>

        <!-- USER FOOTER -->
        <a asp-controller="Account" asp-action="Profile" class="sidebar-user-footer text-decoration-none" title="View Profile">
            <div style="display: flex; align-items: center; gap: 10px;">
                <div class="user-avatar-circle">
                    @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "A")
                </div>
                <div style="line-height: 1.2;">
                    <div style="font-size: 13px; font-weight: 700; color: #ffffff;">@(User.Identity?.Name ?? "Super Admin")</div>
                    <div style="font-size: 11px; color: #64748b;">Store Administrator</div>
                </div>
            </div>
            <i class="fas fa-chevron-right" style="color: #475569; font-size: 12px;"></i>
        </a>
    </aside>

    <!-- MAIN CONTENT -->
    <div class="main-content">
        
        <header class="top-bar">
            <div>
                <h1 class="page-header-title">@ViewData["Title"]</h1>
                <div class="page-header-subtitle">Effortlessly manage your store's products and inventory</div>
            </div>

            <div style="display: flex; align-items: center; gap: 12px;">
                <a href="/" class="btn btn-outline-dark btn-sm rounded-3 fw-bold px-3 py-1.5" style="font-size: 13px; text-decoration: none;" title="Go to Storefront">
                    <i class="fas fa-store me-1.5"></i> Storefront
                </a>
                <a href="#" class="header-icon-btn" title="Search">
                    <i class="fas fa-magnifying-glass"></i>
                </a>
                <a href="#" class="header-icon-btn" title="Notifications">
                    <i class="fas fa-bell"></i>
                    <span class="badge-dot">3</span>
                </a>

                <div class="dropdown d-inline-block">
                    <div href="#" class="d-flex align-items-center gap-2 text-decoration-none dropdown-toggle cursor-pointer ms-2" data-bs-toggle="dropdown" aria-expanded="false" style="cursor: pointer;">
                        <div class="user-avatar-circle">
                            @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "A")
                        </div>
                        <div style="line-height: 1.2;">
                            <div style="font-size: 13px; font-weight: 700; color: #0f172a;">@(User.Identity?.Name ?? "Super Admin")</div>
                            <div style="font-size: 11px; color: #64748b;">Administrator</div>
                        </div>
                    </div>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 p-2 mt-2" style="min-width: 200px; z-index: 1050;">
                        <li><a class="dropdown-item py-2 fw-medium" href="/"><i class="fas fa-store me-2 text-primary"></i> Main Storefront</a></li>
                        <li><a class="dropdown-item py-2 fw-medium" asp-controller="Account" asp-action="Profile"><i class="far fa-user me-2"></i> Admin Profile</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item py-2 text-danger fw-semibold" asp-controller="Account" asp-action="Logout"><i class="fas fa-right-from-bracket me-2"></i> Logout</a></li>
                    </ul>
                </div>
            </div>
        </header>

        <main class="page-body">
            @RenderBody()
        </main>

    </div>

    <!-- Bootstrap Bundle -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)

</body>
</html>