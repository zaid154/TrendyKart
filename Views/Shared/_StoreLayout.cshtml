@{
    Layout = null;
    var curCtrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var curAct = ViewContext.RouteData.Values["action"]?.ToString();
    bool IsHome = curCtrl == "Home" && curAct == "Index";
    bool IsAbout = curCtrl == "Home" && curAct == "About";
    bool IsShop = curCtrl == "Product";
    bool IsContact = curCtrl == "Home" && curAct == "Contact";
    bool IsBlog = curCtrl == "Home" && curAct == "Blog";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TrendyKart</title>

    <!-- Bootstrap 5.3.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Font Awesome 6.5.1 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    
    <link rel="icon" type="image/png" href="~/Favicon.png" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    @* ===== HEADER (Matching templete/Home/home pic 1.png) ===== *@
    <header class="site-header">
        <div class="container header-inner">
            <a class="logo" asp-controller="Home" asp-action="Index" style="font-weight: 800; letter-spacing: -0.5px;">TrendyKart</a>

            <form class="search" method="get" asp-controller="Product" asp-action="Index" style="position: relative;">
                <i class="fas fa-magnifying-glass"></i>
                <input type="text" id="headerSearchInput" name="search" value="@Context.Request.Query["search"]" placeholder="Search" autocomplete="off" onkeyup="fetchSearchSuggestions(this.value)" />
                <div id="searchSuggestionsBox" style="display: none; position: absolute; top: 100%; left: 0; right: 0; background: #fff; border: 1px solid #ddd; border-radius: 8px; box-shadow: 0 10px 25px rgba(0,0,0,0.15); z-index: 1000; margin-top: 4px; overflow: hidden;"></div>
            </form>

            <nav class="main-nav">
                <a class="@(IsHome ? "active" : "")" asp-controller="Home" asp-action="Index">Home</a>
                <a class="@(IsShop ? "active" : "")" asp-controller="Product" asp-action="Index">Shop</a>
                <a class="@(IsAbout ? "active" : "")" asp-controller="Home" asp-action="About">About</a>
                <a class="@(IsContact ? "active" : "")" asp-controller="Home" asp-action="Contact">Contact Us</a>
                <a class="@(IsBlog ? "active" : "")" asp-controller="Home" asp-action="Blog">Blog</a>
            </nav>

            <div class="header-icons">
                <a href="#" title="Wishlist"><i class="far fa-heart"></i></a>
                <a asp-controller="Cart" asp-action="Index" title="Cart"><i class="fas fa-cart-shopping"></i></a>
                @if (User?.Identity?.IsAuthenticated == true)
                {
                    <div class="dropdown d-inline-block">
                        <a href="#" class="dropdown-toggle text-dark text-decoration-none d-flex align-items-center gap-2" data-bs-toggle="dropdown" style="font-size: 14px; font-weight: 600;">
                            <div style="width: 32px; height: 32px; border-radius: 50%; background: #000; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700;">
                                @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                            </div>
                            <span>@User.Identity?.Name</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 p-2 mt-2" style="min-width: 200px;">
                            @if (User.IsInRole("Admin"))
                            {
                                <li><a class="dropdown-item py-2 fw-bold text-dark" asp-controller="Admin" asp-action="Dashboard"><i class="fas fa-shield-halved me-2 text-dark"></i> Admin Panel</a></li>
                                <li><hr class="dropdown-divider"></li>
                            }
                            <li><a class="dropdown-item py-2 fw-medium" asp-controller="Account" asp-action="Profile"><i class="far fa-user me-2"></i> My Profile</a></li>
                            <li><a class="dropdown-item py-2 fw-medium" asp-controller="Order" asp-action="OrderHistory"><i class="fas fa-box me-2"></i> My Orders</a></li>
                            <li><a class="dropdown-item py-2 fw-medium" asp-controller="Cart" asp-action="Index"><i class="fas fa-shopping-cart me-2"></i> My Cart</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item py-2 text-danger fw-semibold" asp-controller="Account" asp-action="Logout"><i class="fas fa-right-from-bracket me-2"></i> Logout</a></li>
                        </ul>
                    </div>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" title="Login"><i class="far fa-user"></i></a>
                }
            </div>
        </div>
    </header>

    @* ===== MAIN BODY ===== *@
    <main class="store">
        @RenderBody()
    </main>

    @* ===== FOOTER ===== *@
    <footer class="site-footer">
        <div class="container footer-grid">
            <div class="footer-brand">
                <div class="logo">TrendyKart</div>
                <p>We are a residential interior design firm located in Portland. Our boutique-studio offers more than just great products.</p>
                <div class="footer-social">
                    <a href="#"><i class="fab fa-twitter"></i></a>
                    <a href="#"><i class="fab fa-facebook-f"></i></a>
                    <a href="#"><i class="fab fa-tiktok"></i></a>
                    <a href="#"><i class="fab fa-instagram"></i></a>
                </div>
            </div>
            <div class="footer-col">
                <h5>Services</h5>
                <a href="#">Bonus program</a>
                <a href="#">Gift cards</a>
                <a href="#">Credit and payment</a>
                <a href="#">Service contracts</a>
                <a href="#">Non-cash account</a>
                <a href="#">Payment</a>
            </div>
            <div class="footer-col">
                <h5>Assistance to the buyer</h5>
                <a asp-controller="Order" asp-action="OrderHistory">Find an order</a>
                <a href="#">Terms of delivery</a>
                <a href="#">Exchange and return of goods</a>
                <a href="#">Guarantee</a>
                <a href="#">Frequently asked questions</a>
                <a href="#">Terms of use of the site</a>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5.3.3 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        let searchTimer;
        function fetchSearchSuggestions(query) {
            clearTimeout(searchTimer);
            const box = document.getElementById('searchSuggestionsBox');
            if (!query || query.trim().length < 2) {
                box.style.display = 'none';
                return;
            }
            searchTimer = setTimeout(() => {
                fetch('/Product/SearchSuggestions?q=' + encodeURIComponent(query))
                    .then(res => res.json())
                    .then(data => {
                        if (data && data.length > 0) {
                            let html = '';
                            data.forEach(item => {
                                html += `
                                <a href="/Product/Details/${item.id}" style="display: flex; align-items: center; gap: 12px; padding: 10px 14px; text-decoration: none; border-bottom: 1px solid #f0f0f0; color: #333; transition: background 0.2s;" onmouseover="this.style.background='#f9f9f9'" onmouseout="this.style.background='#fff'">
                                    <img src="${item.image || '/images/no-image.png'}" style="width: 40px; height: 40px; object-fit: contain;" />
                                    <div style="flex: 1;">
                                        <div style="font-size: 13px; font-weight: 600; color: #000;">${item.name}</div>
                                        <div style="font-size: 11px; color: #777;">${item.category} • ₹${item.price}</div>
                                    </div>
                                </a>`;
                            });
                            box.innerHTML = html;
                            box.style.display = 'block';
                        } else {
                            box.style.display = 'none';
                        }
                    })
                    .catch(() => { box.style.display = 'none'; });
            }, 200);
        }
        document.addEventListener('click', function(e) {
            const box = document.getElementById('searchSuggestionsBox');
            if (box && !e.target.closest('.search')) {
                box.style.display = 'none';
            }
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
