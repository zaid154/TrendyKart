@model IEnumerable<TrendyKart.Models.Coupon>
@{
    ViewData["Title"] = "Coupons Management";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">Discount Coupons</h3>
            <p class="text-muted small mb-0">Create and manage promotional discount codes</p>
        </div>
        <a asp-action="AddCoupon" class="btn btn-primary rounded-pill px-4">
            <i class="fas fa-plus me-1"></i>Create Coupon
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Code</th>
                        <th>Discount</th>
                        <th>Conditions</th>
                        <th>Usage Type</th>
                        <th>Used / Limit</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-primary fs-6 px-3 py-2 font-monospace">@c.Code</span>
                                <div class="small text-muted mt-1">@c.Description</div>
                            </td>
                            <td class="fw-bold text-dark">
                                @(c.DiscountType == "Percentage" ? $"{c.DiscountValue}% OFF" : $"₹{c.DiscountValue} OFF")
                                @if (c.MaxDiscountCap.HasValue)
                                {
                                    <div class="small text-muted">(Cap: ₹@c.MaxDiscountCap)</div>
                                }
                            </td>
                            <td class="small">
                                <div>Min Order: <strong>₹@c.MinOrderAmount</strong></div>
                            </td>
                            <td>
                                <span class="badge @(c.UsageType == "FirstOrderOnly" ? "bg-warning text-dark" : "bg-info text-dark") rounded-pill">
                                    @c.UsageType
                                </span>
                            </td>
                            <td class="fw-semibold">
                                @c.TimesUsed / @(c.TotalUsageLimit.HasValue ? c.TotalUsageLimit.Value.ToString() : "∞")
                            </td>
                            <td>
                                <form method="post" asp-action="ToggleCoupon">
                                    <input type="hidden" name="id" value="@c.CouponID" />
                                    <button type="submit" class="btn btn-sm @(c.IsActive ? "btn-success" : "btn-secondary") rounded-pill px-3">
                                        @(c.IsActive ? "Active" : "Disabled")
                                    </button>
                                </form>
                            </td>
                            <td class="text-end">
                                <a asp-action="DeleteCoupon" asp-route-id="@c.CouponID" class="btn btn-outline-danger btn-sm rounded-circle p-2" onclick="return confirm('Delete this coupon?')">
                                    <i class="fas fa-trash-alt"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
