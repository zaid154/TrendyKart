@model IEnumerable<TrendyKart.Models.Category>
@{
    ViewData["Title"] = "Category & GST Management";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">Categories & GST Setup</h3>
            <p class="text-muted small mb-0">Set default GST percentages per category & sub-category</p>
        </div>
        <button class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#addCategoryModal">
            <i class="fas fa-plus me-1"></i>Add Category
        </button>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        @foreach (var cat in Model)
        {
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="card-header bg-light border-0 py-3 px-4 d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-2">
                            <span class="fs-5 fw-bold text-dark">@cat.Name</span>
                            <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1">GST: @cat.GSTPercentage%</span>
                        </div>
                        <button class="btn btn-sm btn-outline-secondary rounded-circle" data-bs-toggle="modal" data-bs-target="#editCatGstModal-@cat.CategoryID" title="Edit GST">
                            <i class="fas fa-percentage"></i>
                        </button>
                    </div>
                    <div class="card-body p-4">
                        <h6 class="fw-bold text-muted small text-uppercase mb-3">Sub-Categories</h6>
                        @if (cat.SubCategories != null && cat.SubCategories.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead>
                                        <tr class="text-muted small">
                                            <th>Sub-Category Name</th>
                                            <th>GST Override</th>
                                            <th class="text-end">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var sub in cat.SubCategories)
                                        {
                                            <tr>
                                                <td class="fw-semibold text-dark">@sub.Name</td>
                                                <td>
                                                    @if (sub.GSTPercentage.HasValue)
                                                    {
                                                        <span class="badge bg-info-subtle text-info fw-bold">@sub.GSTPercentage%</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small">Inherits (@cat.GSTPercentage%)</span>
                                                    }
                                                </td>
                                                <td class="text-end">
                                                    <button class="btn btn-sm btn-outline-primary rounded-pill" data-bs-toggle="modal" data-bs-target="#editSubGstModal-@sub.SubCategoryID">
                                                        Edit GST
                                                    </button>
                                                </td>
                                            </tr>

                                            @* SubCategory GST Modal *@
                                            <div class="modal fade" id="editSubGstModal-@sub.SubCategoryID" tabindex="-1">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content border-0 shadow rounded-4">
                                                        <form method="post" asp-action="UpdateSubCategoryGST">
                                                            <div class="modal-header border-0">
                                                                <h5 class="modal-title fw-bold">Edit GST for @sub.Name</h5>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                            </div>
                                                            <div class="modal-body">
                                                                <input type="hidden" name="subCategoryId" value="@sub.SubCategoryID" />
                                                                <label class="form-label">GST Percentage (%)</label>
                                                                <input type="number" step="0.01" name="gstPercentage" value="@(sub.GSTPercentage ?? cat.GSTPercentage)" class="form-control" required />
                                                            </div>
                                                            <div class="modal-footer border-0">
                                                                <button type="submit" class="btn btn-primary rounded-pill px-4">Save</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted small mb-0">No sub-categories defined.</p>
                        }

                        <hr class="my-3 text-muted opacity-25" />

                        @* Add SubCategory inline form *@
                        <form method="post" asp-action="AddSubCategory" class="row g-2">
                            <input type="hidden" name="categoryId" value="@cat.CategoryID" />
                            <div class="col-8">
                                <input type="text" name="name" class="form-control form-control-sm" placeholder="New Sub-Category name" required />
                            </div>
                            <div class="col-4">
                                <button type="submit" class="btn btn-sm btn-outline-primary w-100 rounded-3">Add Sub-Cat</button>
                            </div>
                        </form>
                    </div>
                </div>

                @* Category GST Modal *@
                <div class="modal fade" id="editCatGstModal-@cat.CategoryID" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 shadow rounded-4">
                            <form method="post" asp-action="UpdateCategoryGST">
                                <div class="modal-header border-0">
                                    <h5 class="modal-title fw-bold">Edit Category GST: @cat.Name</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    <input type="hidden" name="categoryId" value="@cat.CategoryID" />
                                    <label class="form-label">GST Percentage (%)</label>
                                    <input type="number" step="0.01" name="gstPercentage" value="@cat.GSTPercentage" class="form-control" required />
                                </div>
                                <div class="modal-footer border-0">
                                    <button type="submit" class="btn btn-primary rounded-pill px-4">Save GST</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@* Add Category Modal *@
<div class="modal fade" id="addCategoryModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <form method="post" asp-action="AddCategory">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold">Add Category</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Category Name</label>
                        <input type="text" name="name" class="form-control" placeholder="e.g. Electronics" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">GST Percentage (%)</label>
                        <input type="number" step="0.01" name="gstPercentage" class="form-control" value="18.00" required />
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Create Category</button>
                </div>
            </form>
        </div>
    </div>
</div>
