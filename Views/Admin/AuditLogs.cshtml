@model IEnumerable<TrendyKart.Models.AuditLog>
@{
    ViewData["Title"] = "Audit Trail & Activity Logs";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-user-shield text-primary me-2"></i> Audit Trail & Activity Logs</h2>
        <span class="badge bg-secondary fs-6">Recent 100 Actions</span>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#ID</th>
                            <th>Admin Email</th>
                            <th>Action</th>
                            <th>Entity</th>
                            <th>Entity ID</th>
                            <th>Details</th>
                            <th>Timestamp</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">No audit logs recorded yet.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var log in Model)
                            {
                                <tr>
                                    <td><strong>#@log.LogID</strong></td>
                                    <td>@log.AdminEmail</td>
                                    <td>
                                        <span class="badge @(log.Action == "Delete" ? "bg-danger" : log.Action == "Approve" ? "bg-success" : "bg-info")">
                                            @log.Action
                                        </span>
                                    </td>
                                    <td>@log.EntityName</td>
                                    <td>@(log.EntityID ?? "-")</td>
                                    <td>@log.Details</td>
                                    <td>@log.Timestamp.ToLocalTime().ToString("g")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
