@model IEnumerable<TrendyKart.Models.Customer>
@{
    ViewData["Title"] = "Manage Customers";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="row">
    <div class="col-12">
        <!-- Page Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="mb-0">Manage Customers</h4>

            <a asp-action="Dashboard" class="btn btn-sm btn-outline-dark">
                Back
            </a>
        </div>
        <!-- Content Box -->
        <div class="border rounded p-4">
            <div class="table-responsive">
                <table class="table table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Status</th>
                            <th style="width:180px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>@user.CustomerID</td>
                                <td>@user.FullName</td>
                                <td>@user.Email</td>
                                <td>@user.Phone</td>
                                <td>
                                    @if (user.IsBlocked)
                                    {
                                        <span class="badge bg-danger">Blocked</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-2">

                                        <!-- View -->
                                        <a asp-action="CustomerDetails"
                                           asp-route-id="@user.CustomerID"
                                           class="btn btn-sm btn-outline-dark">
                                            View
                                        </a>
                                        @if (user.IsBlocked)
                                        {
                                            <a asp-action="UnblockUser"
                                               asp-route-id="@user.CustomerID"
                                               class="btn btn-sm btn-outline-success">
                                                Unblock
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-action="BlockUser"
                                               asp-route-id="@user.CustomerID"
                                               class="btn btn-sm btn-outline-danger"
                                               onclick="return confirm('Are you sure you want to block this user?')">
                                                Block
                                            </a>
                                        }

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>