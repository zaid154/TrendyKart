@model TrendyKart.Models.Coupon
@{
    ViewData["Title"] = "Add Coupon";
    Layout = "_AdminLayout";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h4 class="fw-bold text-dark mb-4">Create New Coupon</h4>

                <form method="post" asp-action="AddCoupon">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Coupon Code (Uppercase)</label>
                            <input type="text" asp-for="Code" class="form-control text-uppercase font-monospace fw-bold" placeholder="WELCOME50" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Discount Type</label>
                            <select asp-for="DiscountType" class="form-select">
                                <option value="Flat">Flat (₹ Amount)</option>
                                <option value="Percentage">Percentage (%)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Discount Value</label>
                            <input type="number" step="0.01" asp-for="DiscountValue" class="form-control" placeholder="100" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Max Discount Cap (₹) [Optional]</label>
                            <input type="number" step="0.01" asp-for="MaxDiscountCap" class="form-control" placeholder="200" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Min Order Amount (₹)</label>
                            <input type="number" step="0.01" asp-for="MinOrderAmount" class="form-control" value="500" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Usage Type</label>
                            <select asp-for="UsageType" class="form-select">
                                <option value="EveryOrder">Every Order (Reusable)</option>
                                <option value="FirstOrderOnly">First Order Only</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Total Usage Limit [Optional]</label>
                            <input type="number" asp-for="TotalUsageLimit" class="form-control" placeholder="100" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Per User Limit [Optional]</label>
                            <input type="number" asp-for="PerUserUsageLimit" class="form-control" placeholder="1" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Description</label>
                            <input type="text" asp-for="Description" class="form-control" placeholder="Get ₹100 off on your order" />
                        </div>
                        <div class="col-12 mt-4 d-flex gap-2">
                            <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 fw-bold">Save Coupon</button>
                            <a asp-action="Coupons" class="btn btn-outline-secondary rounded-pill px-4 py-2">Cancel</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
