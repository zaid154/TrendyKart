@model TrendyKart.Models.HomeBlock
@{
    ViewData["Title"] = "Edit Homepage Block";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="mb-0">Edit @Model.Section block</h4>
            <a asp-action="HomeContent" class="btn btn-sm btn-outline-dark">Back</a>
        </div>

        <div class="border rounded p-4">
            <form asp-action="EditHomeBlock" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Section" />
                <input type="hidden" asp-for="Slug" />

                @* Hero uses the "Eyebrow" line; other sections can leave it blank *@
                @if (Model.Section == "Hero")
                {
                    <div class="mb-3">
                        <label asp-for="Eyebrow" class="form-label">Eyebrow (small text above title)</label>
                        <input asp-for="Eyebrow" class="form-control" />
                    </div>
                }

                <div class="mb-3">
                    <label asp-for="Title" class="form-label">Title</label>
                    <input asp-for="Title" class="form-control" />
                </div>

                <div class="mb-3">
                    @if (Model.Section == "CategoryChip")
                    {
                        <label asp-for="Subtitle" class="form-label">Icon class (Font Awesome, e.g. fa-mobile-screen)</label>
                    }
                    else
                    {
                        <label asp-for="Subtitle" class="form-label">Subtitle / description</label>
                    }
                    <input asp-for="Subtitle" class="form-control" />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="ButtonText" class="form-label">Button text (optional)</label>
                        <input asp-for="ButtonText" class="form-control" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="LinkUrl" class="form-label">Link URL</label>
                        <input asp-for="LinkUrl" class="form-control" placeholder="/Product/Index" />
                    </div>
                </div>

                @* Size/Theme only matter for the feature tiles *@
                @if (Model.Section == "FeatureTile")
                {
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Size" class="form-label">Size</label>
                            <select asp-for="Size" class="form-select">
                                <option value="Large">Large</option>
                                <option value="Small">Small</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Theme" class="form-label">Background</label>
                            <select asp-for="Theme" class="form-select">
                                <option value="Light">Light</option>
                                <option value="Gray">Gray</option>
                                <option value="Dark">Dark</option>
                            </select>
                        </div>
                    </div>
                }

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="SortOrder" class="form-label">Sort order</label>
                        <input asp-for="SortOrder" type="number" class="form-control" />
                    </div>
                    <div class="col-md-6 mb-3 pt-4">
                        <div class="form-check">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="IsActive" class="form-check-label">Show on homepage</label>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="mb-3">
                    <label class="form-label">Current image</label>
                    <div>
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" style="max-height:120px;border-radius:8px;" />
                        }
                        else
                        {
                            <span class="text-muted small">No image uploaded yet.</span>
                        }
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="ImageFile" class="form-label">Upload / change image (optional)</label>
                    <input asp-for="ImageFile" type="file" class="form-control" />
                </div>

                <button type="submit" class="btn btn-dark">Save changes</button>
            </form>
        </div>
    </div>
</div>
