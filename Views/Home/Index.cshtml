@model TrendyKart.Models.HomeViewModel
@{
    ViewData["Title"] = "Home";
    Layout = "_StoreLayout";

    var tiles = Model.FeatureTiles;
    var t0 = tiles.FirstOrDefault(t => t.Title.Contains("Playstation") || t.Title.Contains("PS5")) ?? tiles.ElementAtOrDefault(0);
    var t1 = tiles.FirstOrDefault(t => t.Title.Contains("Macbook")) ?? tiles.ElementAtOrDefault(1);
    var t2 = tiles.FirstOrDefault(t => t.Title.Contains("AirPods")) ?? tiles.ElementAtOrDefault(2);
    var t3 = tiles.FirstOrDefault(t => t.Title.Contains("Vision")) ?? tiles.ElementAtOrDefault(3);
}

<style>
    /* Widescreen Section Container */
    .figma-section {
        max-width: 1440px;
        margin: 0 auto 5rem auto;
        padding-left: clamp(1.5rem, 5vw, 5rem);
        padding-right: clamp(1.5rem, 5vw, 5rem);
    }
    .figma-section-title {
        font-size: 1.75rem;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 2rem;
        letter-spacing: -0.5px;
    }
    .figma-bento-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-template-rows: 340px 300px;
        width: 100%;
        background: #ffffff;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0,0,0,0.04);
        border: 1px solid #e2e8f0;
    }
    
    /* Top Left Tile: PS5 */
    .figma-tile-ps5 {
        grid-column: 1;
        grid-row: 1;
        background: #ffffff;
        padding: 3.5rem 3rem;
        display: flex;
        align-items: center;
        gap: 2.5rem;
        border-right: 1px solid #e2e8f0;
        border-bottom: 1px solid #e2e8f0;
    }
    
    /* Right Tall Tile: Macbook Air */
    .figma-tile-macbook {
        grid-column: 2;
        grid-row: 1 / span 2;
        background: #ededed;
        padding: 4rem 3rem 4rem 4rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        overflow: hidden;
        position: relative;
    }
    
    /* Bottom Left Container */
    .figma-bento-bottom-split {
        grid-column: 1;
        grid-row: 2;
        display: grid;
        grid-template-columns: 1fr 1fr;
        border-right: 1px solid #e2e8f0;
    }
    
    /* AirPods Tile */
    .figma-tile-airpods {
        background: #ededed;
        padding: 2.5rem 2rem;
        display: flex;
        align-items: center;
        gap: 1.5rem;
        border-right: 1px solid #e2e8f0;
    }
    
    /* Vision Pro Tile */
    .figma-tile-vision {
        background: #353535;
        color: #ffffff;
        padding: 2.5rem 2rem;
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }
    
    /* Category Section */
    .category-card-figma {
        background: #f5f5f7;
        border-radius: 16px;
        padding: 2rem 1rem;
        text-align: center;
        text-decoration: none;
        color: #0f172a;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
        min-height: 140px;
    }
    .category-card-figma:hover {
        background: #0f172a;
        color: #ffffff;
        transform: translateY(-4px);
        box-shadow: 0 10px 20px rgba(15, 23, 42, 0.12);
    }
    .category-card-figma:hover i {
        color: #ffffff !important;
    }
    
    /* Tabs Header */
    .figma-tab-nav {
        display: flex;
        gap: 2.5rem;
        border-bottom: 1px solid #e2e8f0;
        margin-bottom: 2.5rem;
    }
    .figma-tab-btn {
        background: none;
        border: none;
        padding: 10px 0;
        font-size: 1.15rem;
        font-weight: 500;
        color: #64748b;
        cursor: pointer;
        border-bottom: 2px solid transparent;
        transition: all 0.2s ease;
    }
    .figma-tab-btn.active {
        color: #0f172a;
        border-bottom-color: #0f172a;
        font-weight: 700;
    }

    /* Popular Tile Figma Cards */
    .popular-card-figma {
        background: #f4f4f4;
        border-radius: 20px;
        padding: 2.5rem 1.75rem;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        min-height: 480px;
        transition: all 0.25s ease;
    }
    .popular-card-figma.dark-theme {
        background: #252525;
        color: #ffffff;
    }
    .popular-card-figma:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 24px rgba(0,0,0,0.06);
    }

    /* Sale Banner Figma */
    .sale-banner-figma {
        background: #2e2e38;
        color: #ffffff;
        border-radius: 24px;
        padding: 5rem 4rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: relative;
        overflow: hidden;
    }

    @@media (max-width: 992px) {
        .figma-bento-grid {
            grid-template-columns: 1fr;
            grid-template-rows: auto;
        }
        .figma-tile-macbook {
            grid-column: 1;
            grid-row: auto;
            flex-direction: column;
            padding: 3rem 2rem;
        }
        .figma-bento-bottom-split {
            grid-column: 1;
            grid-row: auto;
            grid-template-columns: 1fr;
        }
        .sale-banner-figma {
            flex-direction: column;
            text-align: center;
            padding: 3rem 1.5rem;
        }
    }
</style>

@* HERO BANNER *@
@if (Model.Hero != null)
{
    <section class="hero mb-5">
        <div class="container hero-inner py-5">
            <div class="hero-text">
                <div class="hero-eyebrow text-uppercase fw-bold mb-2" style="letter-spacing: 1px; font-size: 13px;">@Model.Hero.Eyebrow</div>
                <h1 class="hero-title fw-extrabold text-white mb-3" style="font-size: 3.5rem; line-height: 1.1;">@Html.Raw(Model.Hero.Title)</h1>
                <p class="hero-sub text-white-50 fs-5 mb-4" style="max-width: 540px;">@Model.Hero.Subtitle</p>
                @if (!string.IsNullOrEmpty(Model.Hero.ButtonText))
                {
                    <a class="btn btn-outline-light btn-lg rounded-3 fw-bold px-4 py-2.5" href="@Model.Hero.LinkUrl">@Model.Hero.ButtonText</a>
                }
            </div>
            <div class="hero-img text-center">
                @if (!string.IsNullOrEmpty(Model.Hero.ImageUrl))
                {
                    <img src="@Model.Hero.ImageUrl" alt="@Model.Hero.Title" style="max-height: 420px; object-fit: contain;" />
                }
                else
                {
                    <img src="/images/demo/iphone-hero.png" alt="iPhone 17 Pro Max" style="max-height: 420px; object-fit: contain;" />
                }
            </div>
        </div>
    </section>
}

@* ===== FIGMA BENTO GRID ===== *@
<section class="figma-section">
    <div class="figma-bento-grid">
        
        @* TOP LEFT: Playstation 5 *@
        <div class="figma-tile-ps5">
            <div style="flex: 0 0 42%;">
