            </div>
            <div style="flex: 1;">
                <h2 class="fw-bold text-dark mb-2" style="font-size: 2.75rem; letter-spacing: -1px; line-height: 1.1;">Playstation 5</h2>
                <p class="text-muted small mb-0 lh-relaxed" style="font-size: 14px; max-width: 320px; color: #656565;">
                    Incredibly powerful CPUs, GPUs, and an SSD with integrated I/O will redefine your PlayStation experience.
                </p>
            </div>
        </div>

        @* RIGHT COLUMN: Macbook Air *@
        <div class="figma-tile-macbook" style="overflow: hidden;">
            <div style="max-width: 340px; z-index: 2;">
                <h2 class="fw-light text-dark mb-0" style="font-size: 3.8rem; letter-spacing: -1px; line-height: 1.05;">
                    Macbook
                </h2>
                <h2 class="fw-extrabold text-dark mb-3" style="font-size: 3.8rem; letter-spacing: -1px; line-height: 1.05;">
                    Air
                </h2>
                <p class="small mb-4 lh-relaxed" style="font-size: 14px; color: #656565; max-width: 320px;">
                    The new 15-inch MacBook Air makes room for more of what you love with a spacious Liquid Retina display.
                </p>
                <a href="/Product/Index?category=Computers" class="btn btn-outline-dark rounded-3 px-4 py-2.5 fw-bold" style="font-size: 14px; border-width: 1px;">Shop Now</a>
            </div>
            <div style="flex: 1; text-align: right; z-index: 1; overflow: hidden;">
                <img src="/images/demo/macbook-air.png" alt="Macbook Air" style="max-height: 400px; max-width: 100%; object-fit: contain;" />
            </div>
        </div>

        @* BOTTOM LEFT SPLIT *@
        <div class="figma-bento-bottom-split">
            <!-- AirPods Max -->
            <div class="figma-tile-airpods">
                <img src="/images/demo/airpods-max.png" alt="AirPods Max" style="width: 130px; height: 130px; object-fit: contain; flex-shrink: 0;" />
                <div>
                    <h3 class="fw-normal text-dark mb-0" style="font-size: 1.35rem; line-height: 1.2;">Apple</h3>
                    <h3 class="fw-extrabold text-dark mb-2" style="font-size: 1.35rem; line-height: 1.2;">AirPods Max</h3>
                    <p class="small mb-0" style="font-size: 13px; color: #656565;">Computational audio. Listen, it's powerful</p>
                </div>
            </div>

            <!-- Vision Pro -->
            <div class="figma-tile-vision">
                <img src="/images/demo/vision-pro.png" alt="Vision Pro" style="width: 130px; height: 130px; object-fit: contain; flex-shrink: 0;" />
                <div>
                    <h3 class="fw-normal text-white mb-0" style="font-size: 1.35rem; line-height: 1.2;">Apple</h3>
                    <h3 class="fw-extrabold text-white mb-2" style="font-size: 1.35rem; line-height: 1.2;">Vision Pro</h3>
                    <p class="small mb-0" style="font-size: 13px; color: #9e9e9e;">An immersive way to experience entertainment</p>
                </div>
            </div>
        </div>

    </div>
</section>

@* ===== BROWSE BY CATEGORY ===== *@
<section class="figma-section">
