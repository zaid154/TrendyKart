        <h2 class="figma-section-title m-0">Browse By Category</h2>
        <div class="d-flex gap-2">
            <button class="btn btn-light border rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 40px; height: 40px;" onclick="scrollChips(-1)">
                <i class="fas fa-chevron-left text-dark" style="font-size: 13px;"></i>
            </button>
            <button class="btn btn-light border rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 40px; height: 40px;" onclick="scrollChips(1)">
                <i class="fas fa-chevron-right text-dark" style="font-size: 13px;"></i>
            </button>
        </div>
    </div>

    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-6 g-4" id="chips">
        <div class="col">
            <a class="category-card-figma" href="/Product/Index?category=Phones">
                <i class="fa-solid fa-mobile-screen-button fs-3 text-dark"></i>
                <span class="fw-bold small">Phones</span>
            </a>
        </div>
        <div class="col">
            <a class="category-card-figma" href="/Product/Index?category=Smart%20Watches">
                <i class="fa-solid fa-clock fs-3 text-dark"></i>
                <span class="fw-bold small">Smart Watches</span>
            </a>
        </div>
        <div class="col">
            <a class="category-card-figma" href="/Product/Index?category=Cameras">
                <i class="fa-solid fa-camera fs-3 text-dark"></i>
                <span class="fw-bold small">Cameras</span>
            </a>
        </div>
        <div class="col">
            <a class="category-card-figma" href="/Product/Index?category=Headphones">
                <i class="fa-solid fa-headphones fs-3 text-dark"></i>
                <span class="fw-bold small">Headphones</span>
            </a>
        </div>
        <div class="col">
            <a class="category-card-figma" href="/Product/Index?category=Computers">
                <i class="fa-solid fa-desktop fs-3 text-dark"></i>
                <span class="fw-bold small">Computers</span>
            </a>
        </div>
        <div class="col">
            <a class="category-card-figma" href="/Product/Index?category=Gaming">
                <i class="fa-solid fa-gamepad fs-3 text-dark"></i>
                <span class="fw-bold small">Gaming</span>
            </a>
        </div>
    </div>
</section>

@* ===== PRODUCT TABS: New Arrival / Bestseller / Featured ===== *@
<section class="figma-section">
    <div class="figma-tab-nav">
        <button class="figma-tab-btn active" onclick="showTab(event,'tab-new')">New Arrival</button>
        <button class="figma-tab-btn" onclick="showTab(event,'tab-best')">Bestseller</button>
        <button class="figma-tab-btn" onclick="showTab(event,'tab-feat')">Featured Products</button>
    </div>

    <div id="tab-new" class="tab-panel active">
        @await Html.PartialAsync("_ProductGrid", Model.NewArrivals)
    </div>
    <div id="tab-best" class="tab-panel d-none">
        @await Html.PartialAsync("_ProductGrid", Model.Bestsellers)
    </div>
    <div id="tab-feat" class="tab-panel d-none">
        @await Html.PartialAsync("_ProductGrid", Model.Featured)
    </div>
</section>

