@{
    ViewData["Title"] = "About";
}
<section class="py-4">
    <div class="container text-center">
        <h2 class="fw-bold mb-2">About TrendyKart</h2>
        <p class="text-muted mx-auto mb-2" style="max-width: 650px;">
            TrendyKart is an online shopping platform that makes
            buying products simple, secure, and convenient.
        </p>
        <p class="text-muted mx-auto mb-3" style="max-width: 650px;">
            Browse products, enjoy smooth checkout,
            and manage your orders easily — all in one place.
        </p>
        <p class="mb-1 fw-semibold">Need Help?</p>
        <a href="mailto:trendykart.app@gmail.com"
           class="text-decoration-none d-block mb-3">
            trendykart.app@gmail.com
        </a>
        <a asp-controller="Product"
           asp-action="Index"
           class="btn btn-primary px-4">
            Explore Products
        </a>
    </div>
</section>