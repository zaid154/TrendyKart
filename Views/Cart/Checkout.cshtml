@model IEnumerable<TrendyKart.Models.Cart>
@{
    ViewData["Title"] = "Delivery Address";
}
<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="border rounded p-4">
            <h5 class="text-center mb-4">Delivery Address</h5>
            <form asp-action="ConfirmCheckout" method="post">

                <!-- Full Address -->
                <div class="mb-3">
                    <label class="form-label">Full Address</label>
                    <input type="text"
                           name="ShippingAddress"
                           value="@ViewBag.DefaultStreet"
                           class="form-control"
                           placeholder="House No, Street, Area"
                           required />
                </div>
                <!-- City -->
                <div class="mb-3">
                    <label class="form-label">City</label>
                    <input type="text"
                           name="City"
                           value="@ViewBag.DefaultCity"
                           class="form-control"
                           required />
                </div>
                <!-- State -->
                <div class="mb-3">
                    <label class="form-label">State</label>
                    <input type="text"
                           name="State"
                           value="@ViewBag.DefaultState"
                           class="form-control"
                           required />
                </div>
                <!-- Pincode -->
                <div class="mb-3">
                    <label class="form-label">Pincode</label>
                    <input type="text"
                           name="Pincode"
                           value="@ViewBag.DefaultPincode"
                           class="form-control"
                           pattern="[0-9]{6}"
                           maxlength="6"
                           required />
                    <small class="text-muted">
                        Enter valid 6 digit pincode
                    </small>
                </div>
                <!-- Country -->
                <div class="mb-4">
                    <label class="form-label">Country</label>
                    <input type="text"
                           name="Country"
                           value="India"
                           class="form-control"
                           readonly />
                </div>
                <!-- Buttons -->
                <div class="d-flex justify-content-between">
                    <a asp-controller="Cart"
                       asp-action="Index"
                       class="btn btn-outline-dark">
                        Back to Cart
                    </a>
                    <button type="submit"
                            class="btn btn-dark">
                        Place Order
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>