@model IEnumerable<TrendyKart.Models.Cart>
@{
    ViewData["Title"] = "Shopping Cart";
    Layout = "_StoreLayout";

    var shippingSetting = ViewBag.ShippingSetting as TrendyKart.Models.ShippingSetting ?? new TrendyKart.Models.ShippingSetting();
    decimal subTotal = ViewBag.SubTotal != null ? (decimal)ViewBag.SubTotal : 0;
    decimal shippingCharge = ViewBag.ShippingCharge != null ? (decimal)ViewBag.ShippingCharge : 0;
    decimal cartTotal = ViewBag.CartTotal != null ? (decimal)ViewBag.CartTotal : 0;
    var recommended = ViewBag.RecommendedProducts as List<TrendyKart.Models.Product> ?? new List<TrendyKart.Models.Product>();
    int totalCount = Model.Sum(c => c.Quantity);
}

<style>
    .cart-empty-card {
        background: #ffffff;
        border: 1px solid #e5e5e5;
        border-radius: 16px;
        padding: 50px 30px;
        text-align: center;
        box-shadow: 0 4px 20px rgba(0,0,0,0.02);
        margin-bottom: 40px;
    }

    .cart-empty-icon-box {
        width: 84px;
        height: 84px;
        border-radius: 50%;
        background: #f4f4f6;
        color: #101010;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 36px;
        margin: 0 auto 20px auto;
        box-shadow: inset 0 0 0 1px rgba(0,0,0,0.05);
    }

    .trust-features-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-top: 30px;
        padding-top: 30px;
        border-top: 1px solid #f0f0f0;
    }

    .trust-feature-item {
        display: flex;
        align-items: center;
        gap: 14px;
        text-align: left;
        padding: 12px;
        border-radius: 12px;
        background: #fafafa;
    }

    .trust-feature-item i {
        font-size: 22px;
        color: #101010;
        width: 42px;
        height: 42px;
        border-radius: 10px;
        background: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        flex: 0 0 auto;
    }

    .cart-item-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #ffffff;
        border: 1px solid #e5e5e5;
        border-radius: 14px;
        padding: 20px;
        margin-bottom: 16px;
        transition: all 0.2s ease;
    }

    .cart-item-card:hover {
        border-color: #d0d0d0;
        box-shadow: 0 4px 16px rgba(0,0,0,0.04);
    }

    .cart-img-wrapper {
        width: 90px;
        height: 90px;
        border-radius: 10px;
        background: #f7f7f9;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 8px;
        flex: 0 0 auto;
    }

    .cart-img-wrapper img {
        max-height: 100%;
        max-width: 100%;
        object-fit: contain;
    }

    .summary-card {
        background: #ffffff;
        border: 1px solid #e5e5e5;
        border-radius: 16px;
        padding: 28px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.03);
        position: sticky;
        top: 90px;
    }

    .qty-stepper-btn {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        border: 1px solid #d0d0d0;
        background: #ffffff;
        color: #101010;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .qty-stepper-btn:hover {
        background: #101010;
        color: #ffffff;
        border-color: #101010;
    }

    .recommended-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
    }

    @@media (max-width: 992px) {
        .trust-features-grid {
            grid-template-columns: repeat(2, 1fr);
        }
        .cart-layout-grid {
            grid-template-columns: 1fr !important;
        }
        .recommended-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 576px) {
        .trust-features-grid {
            grid-template-columns: 1fr;
        }
        .recommended-grid {
            grid-template-columns: 1fr;
        }
        .cart-item-card {
            flex-direction: column;
            align-items: flex-start;
            gap: 16px;
        }
    }
</style>

<section class="container section">

    <!-- Breadcrumb -->
    <nav class="crumbs">
        <a asp-controller="Home" asp-action="Index">Home</a>
        <span>/</span>
        <span>Shopping Cart</span>
    </nav>

    @if (!Model.Any())
    {
        <!-- EMPTY CART HUMAN DESIGN STATE -->
        <div class="cart-empty-card">
            <div class="cart-empty-icon-box">
                <i class="fas fa-bag-shopping"></i>
            </div>
            <h2 style="font-size: 24px; font-weight: 700; color: #101010; margin-bottom: 8px;">Your Shopping Cart is Empty</h2>
            <p style="font-size: 14px; color: #666666; max-width: 500px; margin: 0 auto 24px auto;">
                Looks like you haven't added anything to your cart yet. Discover our latest tech gear, trending gadgets, and special deals!
            </p>
            <a asp-controller="Product" asp-action="Index" class="btn-dark" style="padding: 14px 36px; border-radius: 10px; font-size: 15px; font-weight: 600;">
                Explore Products <i class="fas fa-arrow-right ms-2"></i>
            </a>

            <!-- TRUST FEATURES BAR -->
            <div class="trust-features-grid">
                <div class="trust-feature-item">
                    <i class="fas fa-truck-fast"></i>
                    <div>
                        <div style="font-size: 13px; font-weight: 700; color: #101010;">Free Delivery</div>
                        <div style="font-size: 11px; color: #777;">On orders over ₹999</div>
                    </div>
                </div>
                <div class="trust-feature-item">
                    <i class="fas fa-shield-halved"></i>
                    <div>
                        <div style="font-size: 13px; font-weight: 700; color: #101010;">Genuine Brand</div>
                        <div style="font-size: 11px; color: #777;">100% Original Products</div>
                    </div>
                </div>
                <div class="trust-feature-item">
                    <i class="fas fa-arrow-rotate-left"></i>
                    <div>
                        <div style="font-size: 13px; font-weight: 700; color: #101010;">7 Days Return</div>
                        <div style="font-size: 11px; color: #777;">Easy replacements</div>
                    </div>
                </div>
                <div class="trust-feature-item">
                    <i class="fas fa-lock"></i>
                    <div>
                        <div style="font-size: 13px; font-weight: 700; color: #101010;">Secure Payments</div>
                        <div style="font-size: 11px; color: #777;">SSL Encrypted Checkout</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RECOMMENDED PRODUCTS SHOWCASE -->
        @if (recommended.Any())
        {
            <div style="margin-top: 50px;">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px;">
                    <div>
                        <h3 style="font-size: 20px; font-weight: 700; color: #101010; margin: 0 0 4px 0;">Popular Recommendations</h3>
                        <p style="font-size: 13px; color: #666; margin: 0;">Top trending items loved by our customers</p>
                    </div>
                    <a asp-controller="Product" asp-action="Index" style="font-size: 13px; font-weight: 600; color: #101010; text-decoration: underline;">View All</a>
                </div>

                <div class="recommended-grid">
                    @foreach (var p in recommended)
                    {
                        <div class="product-card">
                            <div class="card-img">
                                <img src="@(p.ImageUrl ?? "/images/no-image.png")" alt="@p.Name" />
                            </div>
                            <div class="p-name">@p.Name</div>
                            <div class="p-price">
                                ₹@p.Price
                                @if (p.OldPrice.HasValue && p.OldPrice > p.Price)
                                {
                                    <span class="p-old">₹@p.OldPrice</span>
                                }
                            </div>
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@p.ProductID" class="buy-btn text-center" style="display: block; text-decoration: none;">
                                View Details
                            </a>
                        </div>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <!-- ACTIVE CART ITEMS LAYOUT -->
        <div class="cart-layout-grid" style="display: grid; grid-template-columns: 1fr 380px; gap: 36px; align-items: start;">
            
            <!-- LEFT: CART ITEMS LIST -->
            <div>
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; padding-bottom: 12px; border-bottom: 2px solid #f0f0f0;">
                    <h2 style="font-size: 24px; font-weight: 700; color: #101010; margin: 0;">
                        Shopping Cart <span style="font-size: 14px; font-weight: 500; color: #777;">(@totalCount @(totalCount == 1 ? "item" : "items"))</span>
                    </h2>
                    <a asp-controller="Product" asp-action="Index" style="font-size: 13px; font-weight: 600; color: #101010; text-decoration: underline;">
                        <i class="fas fa-plus me-1"></i> Add More Items
                    </a>
                </div>

                <div>
                    @foreach (var item in Model)
                    {
                        var itemPrice = item.Variant != null ? item.Variant.Price : (item.Product?.Price ?? 0);
                        var itemImage = (item.Variant != null && item.Variant.MediaList != null && item.Variant.MediaList.Any()) 
                            ? item.Variant.MediaList.First().MediaUrl 
                            : (item.Product?.ImageUrl ?? "/images/no-image.png");
                        var sku = item.Variant?.SKU ?? item.Product?.SKU ?? "SKU-" + item.CartID * 1024;

                        <div class="cart-item-card">
                            <div style="display: flex; align-items: center; gap: 20px;">
                                <div class="cart-img-wrapper">
                                    <img src="@itemImage" alt="@item.Product?.Name" />
                                </div>
                                <div>
                                    <h4 style="font-size: 15px; font-weight: 700; color: #101010; margin: 0 0 6px 0;">@item.Product?.Name</h4>
                                    <div style="display: flex; gap: 10px; align-items: center;">
                                        <span style="font-size: 11px; background: #f0f0f4; color: #555; padding: 2px 8px; border-radius: 4px; font-weight: 600;">@sku</span>
                                        <span style="font-size: 13px; color: #666;">₹@itemPrice each</span>
                                    </div>
                                </div>
                            </div>

                            <div style="display: flex; align-items: center; gap: 24px;">
                                <!-- QUANTITY STEPPER -->
                                <form method="post" asp-controller="Cart" asp-action="Update" style="display: flex; align-items: center; gap: 8px;">
                                    <input type="hidden" name="CartID" value="@item.CartID" />
                                    <button type="submit" name="Quantity" value="@(item.Quantity - 1)" class="qty-stepper-btn">-</button>
                                    <span style="font-weight: 700; font-size: 14px; min-width: 24px; text-align: center;">@item.Quantity</span>
                                    <button type="submit" name="Quantity" value="@(item.Quantity + 1)" class="qty-stepper-btn">+</button>
                                </form>

                                <!-- ITEM TOTAL PRICE -->
                                <div style="font-size: 18px; font-weight: 700; color: #101010; min-width: 90px; text-align: right;">
                                    ₹@(itemPrice * item.Quantity)
                                </div>

                                <!-- REMOVE ITEM -->
                                <form method="post" asp-controller="Cart" asp-action="Remove">
                                    <input type="hidden" name="CartID" value="@item.CartID" />
                                    <button type="submit" title="Remove item" style="background: none; border: none; font-size: 16px; color: #aaa; cursor: pointer; transition: color 0.2s;" onmouseover="this.style.color='#dc3545'" onmouseout="this.style.color='#aaa'">
                                        <i class="far fa-trash-can"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- RIGHT: ORDER SUMMARY CARD -->
            <div class="summary-card">
                <h3 style="font-size: 18px; font-weight: 700; color: #101010; margin: 0 0 20px 0; padding-bottom: 12px; border-bottom: 1px solid #f0f0f0;">
                    Order Summary
                </h3>

                <div style="margin-bottom: 20px;">
                    <label style="display: block; font-size: 12px; font-weight: 600; color: #555; margin-bottom: 6px;">Promo / Discount Code</label>
                    <div style="display: flex; gap: 8px;">
                        <input type="text" placeholder="Enter coupon code" style="flex: 1; border: 1px solid #d0d0d0; border-radius: 8px; padding: 10px 12px; font-size: 13px; outline: none;" />
                        <button type="button" class="btn-outline-dark" style="height: 42px; padding: 0 16px; font-size: 13px; border-radius: 8px;">Apply</button>
                    </div>
                </div>

                <div style="display: flex; justify-content: space-between; font-size: 14px; margin-bottom: 12px;">
                    <span style="color: #666;">Subtotal</span>
                    <span style="font-weight: 600; color: #101010;">₹@subTotal</span>
                </div>

                <div style="display: flex; justify-content: space-between; font-size: 14px; margin-bottom: 12px;">
                    <span style="color: #666;">Estimated Tax (GST)</span>
                    <span style="font-weight: 600; color: #16a34a; font-size: 12px; background: #eefdf4; padding: 2px 8px; border-radius: 4px;">Included</span>
                </div>

                <div style="display: flex; justify-content: space-between; font-size: 14px; margin-bottom: 20px;">
                    <span style="color: #666;">Shipping &amp; Handling</span>
                    <span style="font-weight: 600; color: #101010;">
                        @(shippingCharge == 0 ? "FREE" : $"₹{shippingCharge}")
                    </span>
                </div>

                <div style="display: flex; justify-content: space-between; align-items: center; font-size: 18px; font-weight: 700; color: #101010; border-top: 2px solid #f0f0f0; padding-top: 16px; margin-bottom: 24px;">
                    <span>Total Amount</span>
                    <span style="font-size: 22px;">₹@cartTotal</span>
                </div>

                <a asp-controller="Cart" asp-action="Checkout" class="btn-dark text-center" style="display: block; text-decoration: none; width: 100%; padding: 14px; font-size: 15px; font-weight: 600; border-radius: 10px;">
                    <i class="fas fa-lock me-2"></i> Proceed to Checkout
                </a>

                <!-- TRUST PAYMENT ICONS -->
                <div style="text-align: center; margin-top: 20px; padding-top: 16px; border-top: 1px solid #f5f5f5;">
                    <span style="font-size: 11px; color: #888; display: block; margin-bottom: 10px;">Guaranteed Safe &amp; Secure Checkout</span>
                    <div style="display: flex; justify-content: center; gap: 14px; color: #666; font-size: 22px;">
                        <i class="fab fa-cc-visa" title="Visa"></i>
                        <i class="fab fa-cc-mastercard" title="Mastercard"></i>
                        <i class="fas fa-credit-card" title="Razorpay Cards"></i>
                        <i class="fas fa-mobile-screen-button" title="UPI Payment"></i>
                    </div>
                </div>
            </div>

        </div>
    }

</section>