@model IEnumerable<TrendyKart.Models.Order>
@{
    ViewData["Title"] = "My Orders";
}
<div class="row justify-content-center mt-5">
    <div class="col-md-11">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="mb-0">My Orders</h4>
            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-outline-dark">
                Back to Home
            </a>
        </div>
        @if (!Model.Any())
        {
            <div class="border rounded p-4 text-center">
                No orders found.
            </div>
        }
        else
        {
            <div class="border rounded p-4">
                <div class="table-responsive">
                    <table class="table table-bordered align-middle text-center">
                        <thead class="table-light">
                            <tr>
                                <th>Order ID</th>
                                <th>Date</th>
                                <th>Total</th>
                                <th>Payment Status</th>
                                <th style="width:320px;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <!-- Order ID -->
                                    <td>#@order.OrderID</td>
                                    <!-- Date -->
                                    <td>@order.OrderDate.ToString("dd-MMM-yyyy")</td>
                                    <!-- Total -->
                                    <td>₹@order.TotalAmount</td>
                                    <!-- Payment Status -->
                                    <td>
                                        @{
                                            var paymentStatus = order.Payment?.PaymentStatus;
                                        }
                                        @if (order.Status == "Cancelled" && paymentStatus == "Paid")
                                        {
                                            <span class="badge bg-info text-dark">
                                                Refund in 7 working days
                                            </span>
                                        }
                                        else if (paymentStatus == "Refund Initiated")
                                        {
                                            <span class="badge bg-info text-dark">
                                                Refund Initiated
                                            </span>
                                        }
                                        else if (paymentStatus == "Paid")
                                        {
                                            <span class="badge bg-success">Paid</span>
                                        }
                                        else if (paymentStatus == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                        else if (paymentStatus == "Failed")
                                        {
                                            <span class="badge bg-danger">Failed</span>
                                        }
                                        else if (paymentStatus == "Cancelled")
                                        {
                                            <span class="badge bg-secondary">Cancelled</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @order.Status
                                            </span>
                                        }
                                    </td>
                                    <!-- Action Column -->
                                    <td>
                                        <!-- View -->
                                        <a asp-action="OrderDetails"
                                           asp-route-id="@order.OrderID"
                                           class="btn btn-sm btn-outline-dark me-1">
                                            View
                                        </a>
                                        <!-- Cancel (Only Before Shipping) -->
                                        @if (order.Status == "Order Placed")
                                        {
                                            <form asp-action="Cancel"
                                                  asp-route-id="@order.OrderID"
                                                  method="post"
                                                  class="d-inline">
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        onclick="return confirm('Are you sure you want to cancel this order?');">
                                                    Cancel
                                                </button>
                                            </form>
                                        }
                                        <!-- Feedback -->
                                        @if (order.Status == "Delivered")
                                        {
                                            if (order.OrderFeedbacks == null || !order.OrderFeedbacks.Any())
                                            {
                                                <a asp-action="GiveFeedback"
                                                   asp-route-id="@order.OrderID"
                                                   class="btn btn-sm btn-outline-warning">
                                                    Give Feedback
                                                </a>
                                            }
                                            else
                                            {
                                                <a asp-action="ViewFeedback"
                                                   asp-route-id="@order.OrderID"
                                                   class="btn btn-sm btn-outline-success">
                                                    View Feedback
                                                </a>
                                            }
                                        }

                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>