@model IEnumerable<TrendyKart.Models.Order>
@{
    ViewData["Title"] = "My Orders";
    Layout = "_StoreLayout";
}

<style>
    .account-wrapper {
        display: grid;
        grid-template-columns: 280px 1fr;
        gap: 30px;
        align-items: start;
        margin-bottom: 60px;
    }
    .account-sidebar {
        background: #ffffff;
        border: 1px solid #e5e5e5;
        border-radius: 16px;
        padding: 24px 16px;
        position: sticky;
        top: 90px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.02);
    }
    .sidebar-user-info {
        text-align: center;
        padding-bottom: 20px;
        margin-bottom: 20px;
        border-bottom: 1px solid #f0f0f0;
    }
    .avatar-circle {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        background: linear-gradient(135deg, #101010 0%, #333333 100%);
        color: #ffffff;
        font-size: 26px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 12px auto;
        box-shadow: 0 6px 16px rgba(0,0,0,0.12);
        border: 3px solid #ffffff;
    }
    .nav-account {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }
    .nav-account-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 500;
        color: #555555;
        text-decoration: none;
        transition: all 0.2s ease;
    }
    .nav-account-item:hover {
        background: #f5f5f7;
        color: #101010;
    }
    .nav-account-item.active {
        background: #101010;
        color: #ffffff;
        font-weight: 600;
    }
    .nav-account-item.text-danger:hover {
        background: #fff0f0;
        color: #dc3545;
    }
    .orders-card-main {
        background: #ffffff;
        border: 1px solid #e5e5e5;
        border-radius: 16px;
        padding: 32px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.02);
    }
    @@media (max-width: 900px) {
        .account-wrapper {
            grid-template-columns: 1fr;
        }
        .account-sidebar {
            position: static;
        }
        .orders-card-main {
            padding: 20px;
        }
    }
</style>

<section class="container section">

    <!-- Breadcrumb -->
    <nav class="crumbs">
        <a asp-controller="Home" asp-action="Index">Home</a>
        <span>/</span>
        <span>Account</span>
        <span>/</span>
        <span>My Orders</span>
    </nav>

    <div class="account-wrapper">

        <!-- ACCOUNT SIDEBAR -->
        <aside class="account-sidebar">
            <div class="sidebar-user-info">
                <div class="avatar-circle">
                    @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                </div>
                <h4 style="font-size: 16px; font-weight: 700; color: #101010; margin-bottom: 2px;">@User.Identity?.Name</h4>
                <span style="font-size: 12px; color: #777;">Customer Account</span>
            </div>

            <nav class="nav-account">
                <a class="nav-account-item" asp-controller="Account" asp-action="Profile">
                    <i class="fas fa-user-circle"></i>
                    <span>My Profile</span>
                </a>
                <a class="nav-account-item active" asp-controller="Order" asp-action="OrderHistory">
                    <i class="fas fa-box"></i>
                    <span>My Orders</span>
                </a>
                <a class="nav-account-item" asp-controller="Cart" asp-action="Index">
                    <i class="fas fa-shopping-cart"></i>
                    <span>My Cart</span>
                </a>
                <hr style="margin: 10px 0; border-color: #f0f0f0;" />
                <a class="nav-account-item text-danger" asp-controller="Account" asp-action="Logout">
                    <i class="fas fa-arrow-right-from-bracket"></i>
                    <span>Logout</span>
                </a>
            </nav>
        </aside>

        <!-- MAIN ORDERS CONTENT -->
        <main class="orders-card-main">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                <div>
                    <h3 style="font-size: 22px; font-weight: 700; color: #101010; margin: 0 0 4px 0;">My Orders</h3>
                    <p style="font-size: 13px; color: #666; margin: 0;">Track, view details, or give feedback on your orders.</p>
                </div>
                <a asp-controller="Home" asp-action="Index" class="btn-dark" style="font-size: 13px; padding: 10px 18px;">
                    <i class="fas fa-store me-1"></i> Continue Shopping
                </a>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5" style="background: #fafafa; border-radius: 12px; border: 1px dashed #e0e0e0;">
                    <i class="fas fa-box-open text-muted mb-3" style="font-size: 48px;"></i>
                    <h5 style="font-size: 16px; font-weight: 600; color: #333;">No orders found</h5>
                    <p class="text-muted" style="font-size: 14px;">You haven't placed any orders yet.</p>
                    <a asp-controller="Product" asp-action="Index" class="btn-dark mt-2" style="font-size: 14px; padding: 10px 24px;">Explore Shop</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle text-center" style="border: 1px solid #eee; border-radius: 12px; overflow: hidden;">
                        <thead style="background: #101010; color: #ffffff;">
                            <tr>
                                <th style="padding: 14px;">Order ID</th>
                                <th>Date</th>
                                <th>Total</th>
                                <th>Payment Status</th>
                                <th style="width:280px;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                <tr style="border-bottom: 1px solid #f0f0f0;">
                                    <!-- Order ID -->
                                    <td class="fw-bold" style="color: #101010;">#@order.OrderID</td>
                                    <!-- Date -->
                                    <td style="font-size: 14px; color: #555;">@order.OrderDate.ToString("dd-MMM-yyyy")</td>
                                    <!-- Total -->
                                    <td class="fw-bold" style="font-size: 15px; color: #101010;">₹@order.TotalAmount</td>
                                    <!-- Payment Status -->
                                    <td>
                                        @{
                                            var paymentStatus = order.Payment?.PaymentStatus;
                                        }
                                        @if (order.Status == "Cancelled" && paymentStatus == "Paid")
                                        {
                                            <span class="badge bg-info text-dark px-3 py-2" style="border-radius: 20px;">
                                                Refund in 7 working days
                                            </span>
                                        }
                                        else if (paymentStatus == "Refund Initiated")
                                        {
                                            <span class="badge bg-info text-dark px-3 py-2" style="border-radius: 20px;">
                                                Refund Initiated
                                            </span>
                                        }
                                        else if (paymentStatus == "Paid")
                                        {
                                            <span class="badge bg-success px-3 py-2" style="border-radius: 20px;">Paid</span>
                                        }
                                        else if (paymentStatus == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark px-3 py-2" style="border-radius: 20px;">Pending</span>
                                        }
                                        else if (paymentStatus == "Failed")
                                        {
                                            <span class="badge bg-danger px-3 py-2" style="border-radius: 20px;">Failed</span>
                                        }
                                        else if (paymentStatus == "Cancelled")
                                        {
                                            <span class="badge bg-secondary px-3 py-2" style="border-radius: 20px;">Cancelled</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary px-3 py-2" style="border-radius: 20px;">
                                                @order.Status
                                            </span>
                                        }
                                    </td>
                                    <!-- Action Column -->
                                    <td>
                                        <div class="d-flex gap-1 justify-content-center">
                                            <!-- View -->
                                            <a asp-action="OrderDetails"
                                               asp-route-id="@order.OrderID"
                                               class="btn btn-sm btn-outline-dark px-3 rounded-2">
                                                <i class="fas fa-eye me-1"></i> View
                                            </a>
                                            <!-- Cancel (Only Before Shipping) -->
                                            @if (order.Status == "Order Placed")
                                            {
                                                <form asp-action="Cancel"
                                                      asp-route-id="@order.OrderID"
                                                      method="post"
                                                      class="d-inline">
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger px-3 rounded-2"
                                                            onclick="return confirm('Are you sure you want to cancel this order?');">
                                                        Cancel
                                                    </button>
                                                </form>
                                            }
                                            <!-- Feedback -->
                                            @if (order.Status == "Delivered")
                                            {
                                                if (order.OrderFeedbacks == null || !order.OrderFeedbacks.Any())
                                                {
                                                    <a asp-action="GiveFeedback"
                                                       asp-route-id="@order.OrderID"
                                                       class="btn btn-sm btn-warning px-3 rounded-2 text-dark">
                                                        Give Feedback
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a asp-action="ViewFeedback"
                                                       asp-route-id="@order.OrderID"
                                                       class="btn btn-sm btn-success px-3 rounded-2">
                                                        View Feedback
                                                    </a>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </main>

    </div>
</section>